# OpenClaw Diagnostic Dashboard - Environment Configuration
# Copy to /etc/openclaw-diag/openclaw-diag.env and adjust as needed

# Listen port (default: 9090)
OC_DIAG_PORT=9090

# Bind address (default: 0.0.0.0)
OC_DIAG_HOST=0.0.0.0

# API key for remote collector authentication (optional)
# OC_DIAG_API_KEY=your-secret-key-here

# Extra arguments passed to openclaw-dashboard.py
# Examples:
#   --advanced                    Enable advanced diagnostics mode
#   --token mysecret              Require access token for web UI
#   --api-key xxx                 Remote collector auth key
#   --no-local                    Pure remote mode (no local data)
#   --log-dir /path/to/logs       Custom log directory
#   --sessions-dir /path/to/sess  Custom sessions directory
OC_DIAG_EXTRA_ARGS=
